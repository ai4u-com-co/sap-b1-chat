# ============================================================
# sap-b1-chat — Variables de entorno (contrato de env Ai4U v1)
# Lectura centralizada en lib/env.ts (@ai4u/config/env).
# ============================================================

# URL del gateway sap-b1-backend: SAP_BACKEND_URL. En Vercel es una Shared Env Var del
# team (no hace falta copia propia en el proyecto). La lee lib/sap-gateway.ts y se le pasa
# a BackendClient (@ai4u/contracts) como baseUrl: /api/me y las tools SAP usan la misma.
# Alias legados (aceptados con aviso, no usar en config nueva): BACKEND_URL, NEXT_PUBLIC_BACKEND_URL.
# En producción sin ninguna → 503 "Servicio SAP no disponible temporalmente" (nunca localhost).
SAP_BACKEND_URL=http://localhost:4100

# SSO Mission Control + secreto interno (x-internal-secret). Alias legado: MC_INTERNAL_SECRET.
MISSION_CONTROL_SECRET=

# Llave del gateway por tenant (opcional; sin ella se manda "S2S_AUTH" y autentica x-mc-secret).
# TAMAPRINT_SAP_API_KEY=
# FLEXOIMPRESOS_SAP_API_KEY=

# Anthropic por tenant (getProviderKey):
#   {TENANT}_ANTHROPIC_API_KEY -> AI4U_ANTHROPIC_API_KEY -> ANTHROPIC_API_KEY (legado)
# TAMAPRINT_ANTHROPIC_API_KEY=
# FLEXOIMPRESOS_ANTHROPIC_API_KEY=

# Tenant magdalena (modo proxy)
# MAGDALENA_CHAT_URL=

# Persistencia (chat_sessions / chat_tool_calls). Canónico NEXT_PUBLIC_SUPABASE_URL
# (alias SUPABASE_URL, el que hoy tiene Vercel).
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Logs de plataforma (@ai4u/platform) — opcionales
# PLATFORM_INGEST_URL=
# INGEST_SECRET=

# URL completa del changelog service para este tenant/proyecto (NO es la URL base
# del servicio: por eso no es alias de NEXT_PUBLIC_CHANGELOG_URL)
CHANGELOG_URL=https://changelog-service-silk.vercel.app/api/changelog/<tenant>/<proyecto>

# GA ID del tenant (se pasa a initAnalytics() del DS)
# Obtener en Google Analytics → Admin → Data Streams
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Changelog pill (read-path, público) ---
# Tenant/clientId del producto en el changelog-service (multitenant).
NEXT_PUBLIC_CHANGELOG_CLIENT=tamaprint
# appId (opcional; default interno = sap-b1-chat)
NEXT_PUBLIC_CHANGELOG_APP=sap-b1-chat
# URL del servicio (opcional; default = producción)
# NEXT_PUBLIC_CHANGELOG_URL=https://changelog-service-silk.vercel.app
